# Database (managed by docker-compose; override only if running backend outside compose)
DATABASE_URL=postgresql+psycopg://np:np@db:5432/newspaper

# SearXNG (managed by docker-compose)
SEARXNG_URL=http://searxng:8080

# Chat LLM: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, local vLLM/Ollama via LiteLLM, etc.)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Optional: override with Ollama's native /api/chat endpoint.
# When BOTH keys below are set, the agent uses langchain-ollama with
# native tool calling. Structured output goes through Ollama's real tools
# API instead of the OpenAI-compat shim (which has been unreliable for
# function calling). Leave blank to stay on the OPENAI_* path.
# The base URL should NOT include /v1.
OLLAMA_API_BASE=
OLLAMA_MODEL=

# Per-call timeout (seconds) and how many times the SDK retries on timeout /
# transient errors. Default 300s + 3 retries handles slow local models and
# heavy prompts (e.g. a topic with 15+ candidates). Lower if you're on a fast
# hosted model and want to fail faster.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3

# Overall wall-clock budget for one full agent run (all nodes, all retries).
# LLM_TIMEOUT_SECONDS bounds a single request; select/draft/critique loop over
# many topics/batches, so without this a run can stay "running" indefinitely.
# On expiry the issue is marked failed with a clear error.
RUN_TIMEOUT_SECONDS=7200

# How many candidates the LLM's `select` quality filter sees per call. When a
# topic has more than this after dedup, the agent batches: 30 items at
# batch=10 -> 3 LLM calls, each fast and inside the timeout. Lower = more
# robust on slow/small models, more API calls. Higher = fewer calls, risk of
# timeouts or truncated responses.
SELECT_BATCH_SIZE=10

# Hard ceiling on items the LLM can keep per batch. The prompt asks the LLM to
# rank and pick at most this many best-first; code enforces the same number as
# a safety net (slices the LLM's tail, respecting its own ordering). At
# batch=10 and cap=5, no single batch contributes more than half its items.
SELECT_MAX_KEPT_PER_BATCH=5

# Embeddings: separate endpoint/key so chat and embeddings can use different
# providers (e.g. local embeddings + hosted chat). Leave EMBEDDING_API_BASE and
# EMBEDDING_API_KEY blank to fall back to the OPENAI_* values above.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Cross-issue dedup threshold (against story_log from recent issues).
DEDUP_SIM_THRESHOLD=0.88

# Intra-issue dup collapse threshold. Applied within a single run after select,
# using title+summary embeddings. Lower than cross-issue because same-day news
# outlets paraphrase the same event heavily (title-only cosine lands 0.60-0.85
# for the same event). Followed by an LLM dedup pass that catches what the
# embeddings miss.
SELECT_INTRA_SIM_THRESHOLD=0.75

# How often the global RSS poller runs (hours). Feeds with etag/last-modified
# make unchanged polls cheap, so 1 is fine; dial up to 6 or 12 if traffic is a concern.
RSS_POLL_INTERVAL_HOURS=1

# Paths (inside backend container)
ISSUES_DIR=/app/issues

# Comma-separated origins the FastAPI CORS middleware accepts. Default
# matches the Vite dev server in docker-compose; override when deploying
# behind a different hostname.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP for newsletter delivery (notify node + POST /api/issues/{id}/send).
# Leave SMTP_HOST or SMTP_FROM blank to disable delivery; notify records
# status='misconfigured', ad-hoc /send returns 503. Works with any plain
# SMTP provider (Gmail app password, Fastmail, self-hosted, MailHog).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
